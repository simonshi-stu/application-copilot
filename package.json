{
  "name": "application-copilot",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=2.3.2" },
    "contributes": {
      "panel": {
        "id": "application-copilot",
        "name": "投递任务池",
        "icon": "briefcase-line",
        "entry": "integrations/openchamber/panel/index.html"
      },
      "page": true,
      "service": {
        "entry": "integrations/openchamber/service/main.js",
        "runtime": "host"
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "serve": "node scripts/serve.mjs",
    "parse-resume": "node scripts/parse-resume.mjs",
    "mcp": "node mcp/server.mjs",
    "build:openchamber": "node scripts/build-openchamber.mjs",
    "package:openchamber": "node scripts/build-openchamber.mjs && node scripts/package-openchamber.mjs",
    "check:publication": "node scripts/check-publication.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.3.2",
    "esbuild": "0.28.2"
  },
  "engines": { "node": ">=22" }
}
